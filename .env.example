# =============================================================
#  SOLANA MEMECOIN SNIPER — VARIABLES SENSIBLES
# =============================================================
#  ⚠️  NE JAMAIS COMMIT CE FICHIER UNE FOIS REMPLI (.env est gitignore)
#  ⚠️  La clé privée donne un contrôle TOTAL sur votre wallet.
#      Utilisez un wallet DÉDIÉ avec un montant limité.
# =============================================================

# --- RPC / API ---
# Clé API Helius (https://helius.dev) — WebSocket + REST
HELIUS_API_KEY=your_helius_api_key_here

# Endpoint RPC secondaire / fallback (ex: FluxRPC)
FLUXRPC_URL=https://your-fluxrpc-endpoint.example.com

# (Optionnel) URL du moteur de bundles Jito
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf

# --- WALLET ---
# ⚠️ CLÉ PRIVÉE DU WALLET (format base58, comme exporté par Phantom)
# Laissez vide pour un usage en dry-run sans signer de transactions.
WALLET_PRIVATE_KEY=

# --- Webhook (wallet tracking via Helius) ---
# Port local sur lequel le serveur webhook écoute
WEBHOOK_PORT=4000
# Secret partagé pour vérifier l'authenticité des webhooks Helius
WEBHOOK_AUTH_HEADER=change_me_to_a_random_secret

# --- Telegram (interface + alertes) ---
# Token du bot créé via @BotFather
TELEGRAM_BOT_TOKEN=
# Chat IDs admin autorisés à piloter le bot (séparés par des virgules).
# Envoyez /start à votre bot pour récupérer votre chat ID.
TELEGRAM_ADMIN_CHAT_IDS=

# --- Assistant IA (OpenRouter, optionnel) ---
# Clé API OpenRouter (gratuit) : https://openrouter.ai/keys
# Active la commande Telegram /ask (analyse on-chain assistée par IA).
OPENROUTER_API_KEY=
# Modèle (gratuit par défaut). Voir openrouter.ai/models pour d'autres.
OPENROUTER_MODEL=z-ai/glm-4.5-air:free

# Scan global Pump.fun (true = consomme bcp de crédits Helius). false = surveiller seulement les wallets ajoutés.
DETECTION_ENABLED=false
